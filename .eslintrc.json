{
    "env": {
        "browser": true,
        "es2021": true
    },
    "extends": [
        "next/core-web-vitals",
        "airbnb",
        "airbnb-typescript"
    ],
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module",
        "project": "./tsconfig.json"
    },
    "plugins": [
        "react"
    ],
    "rules": {
        "import/extensions": "off",
        "@next/next/no-img-element": "off",
        "react/require-default-props": "off",
        "react/button-has-type": "off"
    }
}
